# Flamingo environment baseline (build order §17).
# Copy to .env (gitignored) and fill real values. Never commit secrets.

# Mandated EDGAR identity — real mailbox required for anything beyond localhost smoke.
SEC_USER_AGENT=Flamingo Research <ops@flamingo.example>

# Database (defaults match infra/docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5434/flamingo
DATABASE_USER=flamingo
DATABASE_PASSWORD=flamingo

# Raw-first store root (R1). S3/MinIO binding arrives with archive work; FS adapter
# is the Phase-0 implementation behind the same interface.
FLAMINGO_RAW_STORE=.data/rawstore

# Live-network master switch. MUST stay 0 except the single owner-authorized
# smoke run (≤1 CIK, token-bucket capped).
LIVE_NET=0

# Test database used by the @Tag("db") migration-convergence suite
FLYWAY_DB_HOST=localhost
FLYWAY_DB_PORT=5434
FLAMINGO_DB_TESTS=0
